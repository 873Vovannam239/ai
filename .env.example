# Đổi các giá trị change-me. KHÔNG chia sẻ file .env với người khác.
POSTGRES_PASSWORD=change-me-db-please
ADMIN_PASSWORD=change-me-login
ADMIN_API_KEY=change-me-admin-key
ADMIN_SESSION_SECRET=change-me-long-random-session-secret-32chars
WORKFLOW_SHARED_SECRET=change-me-workflow-secret
N8N_ENCRYPTION_KEY=change-me-long-random-n8n-encryption-key

# Tạo key ở https://console.groq.com/keys (không đưa key lên chat/GitHub)
GROQ_API_KEY=
# Model Groq hiện có; GPT-OSS 120B hỗ trợ JSON mode.
GROQ_MODEL=openai/gpt-oss-120b

# Gmail: bật xác minh 2 bước, tạo mật khẩu ứng dụng 16 ký tự.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Email nhận thông báo nội bộ/báo cáo/cảnh báo; để trống sẽ dùng SMTP_USER.
RECRUITMENT_NOTIFY_EMAIL=

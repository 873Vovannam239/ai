{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "lib": ["ES2022", "DOM"], "outDir": "./dist", "rootDir": "./src",
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "strict": true, "skipLibCheck": true, "types": ["node", "multer"],
    "sourceMap": false
  }, "include": ["src/**/*.ts"]
}

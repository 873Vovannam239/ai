        "jsCode": "const response = $json || {};\nconst r = response.body && typeof response.body === 'object' ? response.body : response;\nconst upstreamStatus = Number(response.statusCode ?? r.statusCode ?? 200);\nconst transportError = Boolean(response.error) || upstreamStatus >= 400;\nconst backendError = String(response.error?.message || r.message || r.error?.message || r.error || 'Backend request failed');\nconst failureCode = Number.isInteger(upstreamStatus) && upstreamStatus >= 400 && upstreamStatus <= 599 ? upstreamStatus : 502;\nconst scheduleSaved = !transportError && typeof r.id === 'string' && r.id.length > 0;\nconst confirmed = scheduleSaved && r.automation?.ok === true;\nconst partial = scheduleSaved && !confirmed;\nconst status = confirmed ? 'success' : partial ? 'partial' : 'failed';\nconst error = confirmed ? '' : transportError ? backendError : String(r.automation?.message || (partial ? 'Interview saved; invitation delivery is not confirmed. Retry the invitation for this interview, do not recreate the schedule.' : 'Backend did not confirm that the interview was saved'));\nconst httpStatus = confirmed ? 200 : partial ? 207 : failureCode;\nreturn [{json:{ok:confirmed,status,scheduleSaved,httpStatus,result:r,error}}];"

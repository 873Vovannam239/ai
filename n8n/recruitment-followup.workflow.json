      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $json || {};\nconst r = response.body && typeof response.body === 'object' ? response.body : response;\nconst upstreamStatus = Number(response.statusCode ?? r.statusCode ?? 200);\nconst transportError = Boolean(response.error) || upstreamStatus >= 400;\nconst backendError = String(response.error?.message || r.message || r.error?.message || r.error || 'Backend request failed');\nconst failureCode = Number.isInteger(upstreamStatus) && upstreamStatus >= 400 && upstreamStatus <= 599 ? upstreamStatus : 502;\nconst due = Number(r.due);\nconst sent = Number(r.sent);\nconst failed = Number(r.failed);\nconst processing = Number(r.processing ?? 0);\nconst unknown = Number(r.unknown ?? 0);\nconst skipped = Number(r.skipped ?? 0);\nconst validCounts = [due,sent,failed,processing,unknown,skipped].every(n => Number.isInteger(n) && n >= 0) && sent + failed + processing + unknown + skipped <= due;\nconst complete = validCounts && failed === 0 && processing === 0 && unknown === 0 && due === sent + skipped && r.status !== 'partial' && r.status !== 'failed';\nconst ok = !transportError && complete;\nconst status = ok ? 'success' : !transportError && validCounts && (sent > 0 || processing > 0 || skipped > 0 || r.status === 'partial') ? 'partial' : 'failed';\nconst error = ok ? '' : transportError ? backendError : !validCounts ? 'Backend returned invalid reminder counts' : `Reminders incomplete: due=${due}, sent=${sent}, failed=${failed}, processing=${processing}, unknown=${unknown}, skipped=${skipped}`;\nconst httpStatus = ok ? 200 : transportError ? failureCode : status === 'partial' ? 207 : 502;\nreturn [{json:{ok,status,httpStatus,result:r,error}}];"

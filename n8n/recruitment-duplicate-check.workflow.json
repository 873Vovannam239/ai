        "jsCode": "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst body=$json.body ?? {};\nconst jobId=String(body.jobId ?? '').trim();\nconst email=String(body.email ?? '').trim().toLowerCase();\nconst candidateId=String(body.candidateId ?? '').trim();\nconst payload={jobId,email,...(candidateId?{candidateId}:{})};\nconst inputValid=uuid.test(jobId) && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) && (!candidateId || uuid.test(candidateId));\nreturn [{json:{payload,inputValid}}];"
